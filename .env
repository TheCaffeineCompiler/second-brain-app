# Committed deliberately: these are non-secret local-development defaults, shared by
# docker compose and the host CLI so there is one source of truth. Paths are relative
# to the project root, which is what lets the same value work inside the container and
# outside it.
#
# Secrets and machine-specific choices never belong here — put those in .env.local,
# which is gitignored and overrides this file. Real environment variables win over both.
VAULT_REMOTE=.vault-remote/vault.git
VAULT_WORKING_COPY=.working-copy/vault

# Which model runs enrichment (ADR-0024). Override in .env.local.
LLM_PROVIDER=anthropic
